<escape><?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Cross-Browser-Suite" parallel="false">

    <test name="Chrome-Test">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="HamburgerScript.HamburgerNegative"/>
            <class name="CartScript.CartPositive"/>
            <class name="CartScript.CartNegative"/>
            <class name="CheckoutScript.CheckoutNegative"/>
            <class name="CheckoutScript.CheckoutPositive"/>
            <class name="HamburgerScript.HamburgerPositive"/>
            <class name="LoginScript.LogoutScript"/>
            <class name="LoginScript.LoginPositive"/>
            <class name="ProductScript.ProductPositive"/>
            <class name="LoginScript.LoginNegative"/>
            <class name="ProductScript.ProductNegative"/>
        </classes>
    </test>

    <test name="Edge-Test">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="HamburgerScript.HamburgerNegative"/>
            <class name="CartScript.CartPositive"/>
            <class name="CartScript.CartNegative"/>
            <class name="CheckoutScript.CheckoutNegative"/>
            <class name="CheckoutScript.CheckoutPositive"/>
            <class name="HamburgerScript.HamburgerPositive"/>
            <class name="LoginScript.LogoutScript"/>
            <class name="LoginScript.LoginPositive"/>
            <class name="ProductScript.ProductPositive"/>
            <class name="LoginScript.LoginNegative"/>
            <class name="ProductScript.ProductNegative"/>
        </classes>
    </test>

    <test name="Firefox-Test">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="HamburgerScript.HamburgerNegative"/>
            <class name="CartScript.CartPositive"/>
            <class name="CartScript.CartNegative"/>
            <class name="CheckoutScript.CheckoutNegative"/>
            <class name="CheckoutScript.CheckoutPositive"/>
            <class name="HamburgerScript.HamburgerPositive"/>
            <class name="LoginScript.LogoutScript"/>
            <class name="LoginScript.LoginPositive"/>
            <class name="ProductScript.ProductPositive"/>
            <class name="LoginScript.LoginNegative"/>
            <class name="ProductScript.ProductNegative"/>
        </classes>
    </test>

</suite></escape>