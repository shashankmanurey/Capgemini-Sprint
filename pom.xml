								<suiteXmlFile>testng-Parallel-Execution.xml</suiteXmlFile>
							</suiteXmlFiles>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

    <profile>
			<id>RT</id>
			<build>
				<plugins>
